{
  "sections": {
    "cart-section": {
      "type": "main-cart",
      "blocks": {
        "cart-page-title": {
          "type": "_cart-title",
          "static": true,
          "settings": {
            "title": "Carrito",
            "show_count": true,
            "type_preset": "h2",
            "alignment": "left",
            "padding-block-start": 32,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-items": {
          "type": "_cart-products",
          "static": true,
          "settings": {
            "gap": 24,
            "image_ratio": "portrait",
            "dividers": true,
            "vendor": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-summary": {
          "type": "_cart-summary",
          "static": true,
          "settings": {
            "extend_summary": true,
            "inherit_color_scheme": false,
            "color_scheme": "scheme-4",
            "border": "none",
            "border_width": 0,
            "border_opacity": 100,
            "border_radius": 0
          },
          "blocks": {}
        }
      },
      "settings": {
        "section_width": "page-width",
        "color_scheme": "",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "santavila_cart_upsell": {
      "type": "santavila-cart-upsell",
      "settings": {
        "color_scheme": "scheme-1",
        "eyebrow": "También te puede gustar",
        "heading": "Más para tu exterior",
        "max_products": 4
      }
    }
  },
  "order": [
    "cart-section",
    "santavila_cart_upsell"
  ]
}
