{%- liquid
  assign s = section.settings
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign features = section.blocks | where: 'type', 'feature'
-%}
<div class="sv-section sv-hl-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    {%- if benefits.size > 0 -%}
      <div class="sv-hl__grid">
        <div class="sv-hl__media">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 100vw, 50vw', widths: '500,800,1100,1200', alt: s.heading }}
          {%- endif -%}
        </div>
        <div class="sv-hl__list">
          {%- if s.eyebrow != blank -%}<p class="sv-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="sv-hl__title">{{ s.heading }}</h2>{%- endif -%}
          {%- for b in benefits -%}
            <div class="sv-hl__item" {{ b.shopify_attributes }}>
              <span class="sv-hl__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
              </span>
              <div>
                <h4>{{ b.settings.title }}</h4>
                {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if features.size > 0 -%}
      <div class="sv-hl__features">
        {%- for f in features -%}
          <div class="sv-hl__feat" {{ f.shopify_attributes }}>
            <span class="sv-hl__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h4>{{ f.settings.title }}</h4>
            {%- if f.settings.text != blank -%}<p>{{ f.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sv-hl-section { background-color: var(--color-background); color: var(--color-foreground); }
  .sv-hl__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,6vw,90px); align-items: center; }
  .sv-hl__media { aspect-ratio: 4/4.6; position: relative; overflow: hidden; border-radius: var(--radius-media); background: var(--bone); }
  .sv-hl__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease,ease); }
  @media (hover: hover) { .sv-hl__media:hover img { transform: scale(1.04); } }
  .sv-hl__title { font-family: var(--serif); font-weight: 500; font-size: clamp(28px,3.6vw,46px); line-height: 1.04; margin: 12px 0 28px; }
  .sv-hl__item { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start; padding: 18px 0; border-top: 1px solid var(--line); }
  .sv-hl__item:first-of-type { border-top: none; }
  .sv-hl__icon { width: 38px; height: 38px; border-radius: 99px; background: var(--sage-50); color: var(--sage-deep); display: grid; place-items: center; flex: none; }
  .sv-hl__item h4 { font-family: var(--sans); font-size: 17px; font-weight: 600; margin: 0 0 4px; }
  .sv-hl__item p { font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .sv-hl__features { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(20px,3vw,48px); margin-top: clamp(40px,5vw,72px); }
  .sv-hl__feat { border-top: 1px solid var(--ink); padding-top: 18px; }
  .sv-hl__num { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--sage); }
  .sv-hl__feat h4 { font-family: var(--serif); font-size: 22px; font-weight: 500; margin: 8px 0 8px; }
  .sv-hl__feat p { font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  @media screen and (max-width: 860px) {
    .sv-hl__grid { grid-template-columns: 1fr; }
    .sv-hl__features { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila PDP Highlights",
  "tag": "section",
  "class": "sv-hl-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Imagen (beneficios)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Por qué Santavila" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Pensado para durar fuera" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Beneficio", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Resiste sol, lluvia y salitre" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Materiales probados en exterior real español." }
    ]},
    { "type": "feature", "name": "Característica", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Cuerda náutica" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Tacto textil, color estable al sol." }
    ]}
  ],
  "presets": [ {
    "name": "Santavila PDP Highlights",
    "blocks": [
      { "type": "benefit", "settings": { "title": "Resiste sol, lluvia y salitre", "text": "Materiales probados en exterior real español: UV, humedad y costa." } },
      { "type": "benefit", "settings": { "title": "Asiento profundo y cojines desenfundables", "text": "Comodidad de salón y fundas que se lavan sin complicaciones." } },
      { "type": "benefit", "settings": { "title": "Fácil de montar en casa", "text": "Llega en pocos bultos con instrucciones claras; lo montas tú." } },
      { "type": "feature", "settings": { "title": "Estructura de aluminio", "text": "Ligera y resistente, no se oxida." } },
      { "type": "feature", "settings": { "title": "Modular", "text": "Combina módulos según tu espacio." } },
      { "type": "feature", "settings": { "title": "Garantía legal", "text": "Cubierta por la garantía legal, sin letra pequeña." } }
    ]
  } ]
}
{% endschema %}
