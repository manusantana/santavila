{%- liquid
  assign s = section.settings
  assign seals = section.blocks
-%}
<div class="sv-section sv-trust-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    {%- if s.heading != blank -%}
      <div class="sv-trust__head">
        {%- if s.eyebrow != blank -%}<p class="sv-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="sv-trust__title">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if seals.size > 0 -%}
      <div class="sv-trust__grid">
        {%- for b in seals -%}
          <div class="sv-trust__item" {{ b.shopify_attributes }}>
            <span class="sv-trust__icon" aria-hidden="true">
              {%- case b.settings.icon -%}
                {%- when 'spain' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/></svg>
                {%- when 'warranty' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- when 'secure' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
                {%- when 'returns' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-7 3.4"/><path d="M4 3v4h4"/></svg>
                {%- when 'support' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 01-11.5 7.2L4 20l1-4.5A8 8 0 1121 12z"/></svg>
                {%- when 'assembly' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15l12-12 6 6L9 21z"/><path d="M7.5 10.5l2 2"/></svg>
              {%- endcase -%}
            </span>
            {%- if b.settings.title != blank -%}<h4>{{ b.settings.title }}</h4>{%- endif -%}
            {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.includes != blank -%}
      <div class="sv-trust__includes">
        {%- if s.includes_heading != blank -%}<h3 class="sv-trust__inc-title">{{ s.includes_heading }}</h3>{%- endif -%}
        <div class="sv-trust__inc-body">{{ s.includes }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sv-trust-section { background-color: var(--color-background); color: var(--color-foreground); }
  .sv-trust__head { text-align: center; margin-bottom: clamp(36px,5vw,56px); }
  .sv-trust__title { font-family: var(--serif); font-weight: 500; font-size: clamp(28px,3.6vw,46px); line-height: 1.04; max-width: 20ch; margin: 12px auto 0; text-wrap: balance; }
  .sv-trust__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(20px,2.4vw,32px); }
  .sv-trust__item { background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius-media); padding: clamp(22px,2.4vw,30px); }
  .sv-trust__icon { color: var(--sage); display: block; margin-bottom: 14px; }
  .sv-trust__item h4 { font-family: var(--sans); font-size: 16.5px; font-weight: 600; margin: 0 0 6px; color: var(--ink); }
  .sv-trust__item p { font-family: var(--sans); font-size: 14px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .sv-trust__includes { margin-top: clamp(40px,6vw,72px); background: var(--bone); border-radius: var(--radius-media); padding: clamp(28px,4vw,52px); text-align: center; }
  .sv-trust__inc-title { font-family: var(--serif); font-weight: 500; font-size: clamp(22px,2.4vw,32px); margin: 0 0 14px; }
  .sv-trust__inc-body, .sv-trust__inc-body p, .sv-trust__inc-body li { font-family: var(--sans); font-size: 16px; line-height: 1.65; color: var(--ink-2); }
  .sv-trust__inc-body { max-width: 56ch; margin-inline: auto; }
  @media screen and (max-width: 860px) {
    .sv-trust__grid { grid-template-columns: 1fr; }
  }
  @media screen and (min-width: 561px) and (max-width: 860px) {
    .sv-trust__grid { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila PDP Confianza",
  "tag": "section",
  "class": "sv-trust-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Comprar con tranquilidad" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Razones reales para confiar" },
    { "type": "header", "content": "Qué incluye" },
    { "type": "text", "id": "includes_heading", "label": "Titular", "default": "Llega listo para montar" },
    { "type": "richtext", "id": "includes", "label": "Contenido", "default": "<p>Estructura, cojines desenfundables, instrucciones ilustradas y kit de montaje. Sin servicio de montaje a domicilio: lo montas tú, sin herramientas especiales.</p>" }
  ],
  "blocks": [
    { "type": "seal", "name": "Sello", "settings": [
      { "type": "select", "id": "icon", "label": "Icono", "options": [
        { "value": "spain", "label": "Hecho en España" },
        { "value": "warranty", "label": "Garantía" },
        { "value": "secure", "label": "Pago seguro" },
        { "value": "returns", "label": "Devoluciones" },
        { "value": "support", "label": "Atención" },
        { "value": "assembly", "label": "Montaje" }
      ], "default": "spain" },
      { "type": "text", "id": "title", "label": "Título", "default": "Hecho en España" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Diseño y fabricación españoles." }
    ]}
  ],
  "presets": [ {
    "name": "Santavila PDP Confianza",
    "blocks": [
      { "type": "seal", "settings": { "icon": "spain", "title": "Hecho en España", "text": "Diseño y fabricación españoles, pensados para nuestro clima." } },
      { "type": "seal", "settings": { "icon": "secure", "title": "Pago 100% seguro", "text": "Pasarela de pago de Shopify, cifrada." } },
      { "type": "seal", "settings": { "icon": "warranty", "title": "Garantía legal", "text": "Cubierta por la garantía legal, sin letra pequeña." } },
      { "type": "seal", "settings": { "icon": "returns", "title": "Devolución legal", "text": "Derecho de desistimiento según la ley." } },
      { "type": "seal", "settings": { "icon": "support", "title": "Atención personalizada", "text": "Email, WhatsApp y chat para ayudarte con medidas y combinaciones." } },
      { "type": "seal", "settings": { "icon": "assembly", "title": "Fácil de montar en casa", "text": "Pocos bultos, instrucciones ilustradas; lo montas tú." } }
    ]
  } ]
}
{% endschema %}
