{%- liquid
  assign s = section.settings
-%}

<div class="sv-section sv-scenarios-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-prow__head">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="sv-eyebrow" style="margin-bottom:14px">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sv-scenarios__title">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: '#' }}" class="sv-ulink">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="sv-scenes">
      {%- for block in section.blocks -%}
        {%- assign num = forloop.index | prepend: '0' | slice: -2, 2 -%}
        <a
          class="sv-scene"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="sv-scene__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 980px) 50vw, 25vw',
                  widths: '300, 450, 600, 900',
                  alt: block.settings.name
              }}
            {%- endif -%}
          </div>
          <div class="sv-scene__label">
            <div class="sv-scene__num">{{ block.settings.number | default: num }}</div>
            <div class="sv-scene__name">
              {{ block.settings.name }}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sv-prow__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .sv-scenarios__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .sv-scenes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .sv-scene {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4.3;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--sand);
    color: #fff;
  }
  .sv-scene__media {
    position: absolute;
    inset: 0;
  }
  .sv-scene__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s var(--ease, ease);
  }
  .sv-scene:hover .sv-scene__media img {
    transform: scale(1.05);
  }
  .sv-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(20, 22, 16, 0.6), transparent 55%);
    z-index: 1;
  }
  .sv-scene__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 24px;
  }
  .sv-scene__num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    opacity: 0.8;
  }
  .sv-scene__name {
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 500;
    margin-top: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sv-scene__name svg {
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.4s var(--ease, ease);
  }
  .sv-scene:hover .sv-scene__name svg {
    opacity: 1;
    transform: none;
  }
  @media screen and (max-width: 980px) {
    .sv-scenes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-scene__media img,
    .sv-scene__name svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Escenarios",
  "tag": "section",
  "class": "sv-scenarios-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Empieza por tu espacio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Amueblar por escenario"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Enlace · texto",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Enlace · destino"
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Escenario",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "info": "Vacío = numeración automática (01, 02…)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre del escenario",
          "default": "Áticos y terrazas"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (colección)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Santavila Escenarios",
      "blocks": [
        { "type": "scenario", "settings": { "name": "Áticos y terrazas" } },
        { "type": "scenario", "settings": { "name": "Balcón" } },
        { "type": "scenario", "settings": { "name": "Jardín y porche" } },
        { "type": "scenario", "settings": { "name": "Comedores" } }
      ]
    }
  ]
}
{% endschema %}
