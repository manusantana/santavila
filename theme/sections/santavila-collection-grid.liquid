{%- liquid
  assign s = section.settings
  assign per_page = s.products_per_page | default: 24

  assign has_active = false
  for f in collection.filters
    if f.active_values.size > 0
      assign has_active = true
    endif
    if f.type == 'price_range'
      if f.min_value.value != null or f.max_value.value != null
        assign has_active = true
      endif
    endif
  endfor
-%}

{%- capture hidden_all -%}
  {%- for f in collection.filters -%}
    {%- if f.type == 'price_range' -%}
      {%- if f.min_value.value != null -%}<input type="hidden" name="{{ f.min_value.param_name }}" value="{{ f.min_value.value }}">{%- endif -%}
      {%- if f.max_value.value != null -%}<input type="hidden" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value }}">{%- endif -%}
    {%- else -%}
      {%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture hidden_lists -%}
  {%- for f in collection.filters -%}
    {%- unless f.type == 'price_range' -%}
      {%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture geo_links -%}
  {%- case collection.handle -%}
    {%- when 'sillones-de-exterior' -%}
      <a href="/products/sofa-terraza-2-plazas-estilo-contemporaneo-12078-cm">Sofá terraza 120 cm</a>
      <a href="/products/sofa-terraza-2-plazas-estilo-contemporaneo-13090-cm">Sofá exterior 130 cm</a>
      <a href="/products/set-rinconera-exterior-contemporaneo-sofa-de-esquina-mesa-de-centro">Rinconera de terraza</a>
    {%- when 'tumbonas' -%}
      <a href="/products/balliu-tumbona-de-exterior-resina-28ff014d">Tumbona Balliu resina</a>
      <a href="/products/balliu-tumbona-de-exterior-resina-75-cm-009e68e4">Tumbona resina 75 cm</a>
      <a href="/products/balliu-tumbona-de-exterior-aluminio-d08586c1">Tumbona aluminio exterior</a>
    {%- when 'parasoles' -%}
      <a href="/products/base-de-parasol-25-kg">Base de parasol 25 kg</a>
      <a href="/collections/accesorios">Bases para sombrilla</a>
      <a href="/products/pergola-aluminio-para-jardin-300300250-cm">Pérgola 250x300</a>
    {%- when 'accesorios' -%}
      <a href="/products/base-de-parasol-25-kg">Base para sombrilla 25 kg</a>
      <a href="/collections/parasoles">Parasoles para terraza</a>
      <a href="/products/balliu-colchoneta-para-tumbona-0e9a3256">Colchonetas para tumbona</a>
    {%- when 'mesas' -%}
      <a href="/products/banco-jardin-con-mesa-integrada-220-cm">Banco con mesa incorporada</a>
      <a href="/collections/sillas-de-exterior">Sillas para mesa exterior</a>
      <a href="/blogs/news/como-elegir-muebles-de-exterior-que-duren-aluminio-teca-o-ratan-sintetico">Guía de materiales</a>
    {%- when 'sillas-de-exterior' -%}
      <a href="/collections/mesas">Mesas de exterior</a>
      <a href="/blogs/news/como-elegir-muebles-de-exterior-que-duren-aluminio-teca-o-ratan-sintetico">Guía de materiales</a>
      <a href="/collections/sillones-de-exterior">Sofás de exterior</a>
  {%- endcase -%}
{%- endcapture -%}

{%- comment -%}
  window_size: 4 → con ≤9 páginas se muestran TODAS sin elipsis. El catálogo no pasa
  de 4 páginas por colección (88 prod / 24), así que la serie sale siempre completa
  (1 2 3 4) → cada página a 1 clic real. Si algún día una colección supera 9 páginas,
  aparecerán elipsis y el layout ya envuelve en móvil (verificado).
{%- endcomment -%}
{%- paginate collection.products by per_page, window_size: 4 -%}
<div class="sv-coll color-{{ s.color_scheme }}">
  <div class="sv-filterbar">
    <div class="sv-container sv-filterbar__in">
      <div class="sv-facets" data-facets>
        {%- for filter in collection.filters -%}
          {%- liquid
            assign active_n = filter.active_values.size
            assign price_active = false
            if filter.type == 'price_range'
              if filter.min_value.value != null or filter.max_value.value != null
                assign price_active = true
              endif
            endif
          -%}
          <details class="sv-facet">
            <summary class="sv-chip {% if active_n > 0 or price_active %}is-on{% endif %}">
              {{ filter.label }}{% if active_n > 0 %} · {{ active_n }}{% endif %}
              <svg class="sv-facet__caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="sv-facet__panel">
              {%- case filter.type -%}
                {%- when 'boolean', 'list' -%}
                  <ul class="sv-facet__opts">
                    {%- for value in filter.values -%}
                      <li>
                        <a
                          href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                          class="sv-facet__opt {% if value.active %}is-active{% endif %}"
                          {% if value.count == 0 and value.active == false %}aria-disabled="true" tabindex="-1"{% endif %}
                        >
                          <span class="sv-facet__box">{% if value.active %}<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>{% endif %}</span>
                          <span class="sv-facet__lbl">{{ value.label }}</span>
                          <span class="sv-facet__count">{{ value.count }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <form method="get" action="{{ collection.url }}" class="sv-facet__price">
                    {{ hidden_lists }}
                    <div class="sv-price-row">
                      <input type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="{{ filter.range_min | money_without_trailing_zeros | strip_html }}" min="0" aria-label="Precio mínimo">
                      <span aria-hidden="true">–</span>
                      <input type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ filter.range_max | money_without_trailing_zeros | strip_html }}" min="0" aria-label="Precio máximo">
                    </div>
                    <button type="submit" class="sv-btn sv-btn--line sv-btn--sm">Aplicar</button>
                  </form>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
        {%- if has_active -%}
          <a href="{{ collection.url }}" class="sv-facets__clear">Limpiar</a>
        {%- endif -%}
      </div>

      <div class="sv-sortwrap">
        <span class="sv-count">{{ collection.products_count }} producto{% if collection.products_count != 1 %}s{% endif %}</span>
        {%- if collection.sort_options.size > 0 -%}
          <form method="get" action="{{ collection.url }}" class="sv-sortform">
            {{ hidden_all }}
            <div class="sv-sortsel">
              <span>Ordenar</span>
              <select name="sort_by" aria-label="Ordenar por" onchange="this.form.submit()">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </form>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="sv-container sv-coll__body">
    {%- assign geo_links_clean = geo_links | strip -%}
    {%- if geo_links_clean != blank and paginate.current_page == 1 -%}
      <nav class="sv-csuggest" aria-label="Rutas recomendadas">
        <span class="sv-csuggest__label">También se busca</span>
        <div class="sv-csuggest__links">{{ geo_links }}</div>
      </nav>
    {%- endif -%}
    {%- if paginate.current_page == 1 -%}
      <nav class="sv-ctrust" aria-label="Información de compra">
        <span>Compra con tranquilidad</span>
        <a href="/pages/envio">Entrega</a>
        <a href="/pages/garantia">Garantía</a>
        <a href="/pages/mantenimiento">Mantenimiento</a>
        <a href="/pages/sobre-santavila">Sobre Santavila</a>
      </nav>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="sv-cgrid" id="sv-cgrid">
        {%- for product in collection.products -%}
          {%- render 'santavila-product-card', product: product, sizes: '(max-width: 749px) 50vw, (max-width: 989px) 50vw, 33vw' -%}
          {%- if paginate.current_page == 1 and forloop.index == s.band_after and s.band_heading != blank -%}
            <div class="sv-cband">
              {%- if s.band_image != blank -%}
                <div class="sv-cband__media">{{ s.band_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,1000,1400,1600', alt: s.band_heading }}</div>
              {%- endif -%}
              <div class="sv-cband__in">
                {%- if s.band_eyebrow != blank -%}<p class="sv-eyebrow" style="color:var(--sage-soft)">{{ s.band_eyebrow }}</p>{%- endif -%}
                <h3 class="sv-cband__title">{{ s.band_heading }}</h3>
                {%- if s.band_text != blank -%}<p class="sv-cband__text">{{ s.band_text }}</p>{%- endif -%}
                {%- if s.band_cta_label != blank and s.band_cta_link != blank -%}
                  <a href="{{ s.band_cta_link }}" class="sv-btn sv-btn--light">{{ s.band_cta_label }}
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        Paginación numerada (SEO): enlaces <a> reales a TODAS las páginas de la ventana.
        Evita el "túnel de paginación" del patrón solo-siguiente, que dejaba los productos
        de las últimas páginas a N clics de profundidad. Cada página tiene su URL ?page=N
        y su canonical auto-referenciado (lo aporta el tema en meta-tags).
      {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
        <nav class="sv-pag" role="navigation" aria-label="Paginación de productos">
          {%- comment -%} Un solo nivel flex-wrap: prev, números y next son hermanos → envuelve limpio en móvil sin desbordar. {%- endcomment -%}
          <ol class="sv-pag__list">
            <li class="sv-pag__item">
              {%- if paginate.previous -%}
                <a class="sv-pag__arrow" href="{{ paginate.previous.url }}" rel="prev" aria-label="Página anterior">&lsaquo;</a>
              {%- else -%}
                <span class="sv-pag__arrow is-off" aria-hidden="true">&lsaquo;</span>
              {%- endif -%}
            </li>
            {%- for part in paginate.parts -%}
              <li class="sv-pag__item">
                {%- if part.is_link -%}
                  <a class="sv-pag__n" href="{{ part.url }}" aria-label="Ir a la página {{ part.title }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="sv-pag__n is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="sv-pag__gap" aria-hidden="true">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            <li class="sv-pag__item">
              {%- if paginate.next -%}
                <a class="sv-pag__arrow" href="{{ paginate.next.url }}" rel="next" aria-label="Página siguiente">&rsaquo;</a>
              {%- else -%}
                <span class="sv-pag__arrow is-off" aria-hidden="true">&rsaquo;</span>
              {%- endif -%}
            </li>
          </ol>
        </nav>

        <p class="sv-pag__count">Página {{ paginate.current_page }} de {{ paginate.pages }} · {{ paginate.items }} productos</p>
      {%- endif -%}
    {%- else -%}
      <p class="sv-coll__empty">No hay productos que coincidan con estos filtros. <a href="{{ collection.url }}">Quitar filtros</a>.</p>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var facets = Array.prototype.slice.call(document.querySelectorAll('[data-facets] .sv-facet'));
    if (!facets.length) return;
    facets.forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) {
          facets.forEach(function (o) { if (o !== d) o.open = false; });
        }
      });
    });
    document.addEventListener('click', function (e) {
      facets.forEach(function (d) {
        if (d.open && !d.contains(e.target)) d.open = false;
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') facets.forEach(function (d) { d.open = false; });
    });
  })();
</script>
{%- endpaginate -%}

{% stylesheet %}
  .sv-coll {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  /* Filter bar sticky bajo el header */
  .sv-filterbar {
    position: sticky;
    top: var(--header-height, 64px);
    z-index: var(--layer-sticky, 8);
    background: rgba(247, 244, 236, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .sv-filterbar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-block: 16px;
    flex-wrap: wrap;
  }
  .sv-chips {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
  }
  .sv-chip {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    border: 1px solid var(--line);
    background: var(--paper-2);
    border-radius: 99px;
    padding: 9px 16px;
    color: var(--ink-2);
    transition: all 0.25s var(--ease, ease);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    white-space: nowrap;
  }
  .sv-chip:hover {
    border-color: var(--sage);
    color: var(--ink);
  }
  .sv-chip.is-on {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .sv-chip[aria-disabled="true"] {
    opacity: 0.4;
    pointer-events: none;
  }
  .sv-chip svg {
    opacity: 0.6;
  }

  .sv-facets {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }
  .sv-facet {
    position: relative;
  }
  .sv-facet > summary {
    list-style: none;
  }
  .sv-facet > summary::-webkit-details-marker {
    display: none;
  }
  .sv-facet__caret {
    transition: transform 0.25s var(--ease, ease);
  }
  .sv-facet[open] > summary .sv-facet__caret {
    transform: rotate(180deg);
  }
  .sv-facet[open] > summary {
    border-color: var(--sage);
    color: var(--ink);
  }
  .sv-facet__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 6;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 14px 40px rgba(35, 37, 29, 0.14);
    min-width: 240px;
    max-width: calc(100vw - 40px);
    max-height: 340px;
    overflow-y: auto;
  }
  .sv-facet__opts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sv-facet__opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 9px;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 14px;
    transition: background 0.2s var(--ease, ease);
  }
  .sv-facet__opt:hover {
    background: var(--bone);
    color: var(--ink);
  }
  .sv-facet__opt[aria-disabled="true"] {
    opacity: 0.4;
    pointer-events: none;
  }
  .sv-facet__box {
    width: 18px;
    height: 18px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: #fff;
    display: grid;
    place-items: center;
    color: var(--paper);
  }
  .sv-facet__opt.is-active .sv-facet__box {
    background: var(--ink);
    border-color: var(--ink);
  }
  .sv-facet__lbl {
    flex: 1;
  }
  .sv-facet__opt.is-active .sv-facet__lbl {
    color: var(--ink);
    font-weight: 500;
  }
  .sv-facet__count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .sv-facet__price {
    padding: 6px;
  }
  .sv-facets__clear {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 4px;
    white-space: nowrap;
  }
  .sv-price-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .sv-price-row input {
    width: 100%;
    min-width: 0;
    font-family: var(--sans);
    font-size: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 12px;
    background: #fff;
    color: var(--ink);
  }
  .sv-price-row input:focus {
    outline: none;
    border-color: var(--sage);
  }
  .sv-btn--sm {
    font-size: 12.5px;
    padding: 10px 20px;
    width: 100%;
    justify-content: center;
  }

  .sv-sortwrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sv-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .sv-sortsel {
    position: relative;
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 600;
    border: 1px solid var(--line);
    background: var(--paper-2);
    border-radius: 99px;
    padding: 9px 16px;
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sv-sortsel select {
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    padding-right: 2px;
  }
  .sv-sortsel select:focus {
    outline: none;
  }

  /* Grid */
  .sv-coll__body {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .sv-csuggest {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 3.4vw, 42px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .sv-csuggest__label {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sv-csuggest__links {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }
  .sv-csuggest__links a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 8px 14px;
    background: var(--paper-2);
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 13.5px;
    line-height: 1.2;
    transition: border-color 0.25s var(--ease, ease), color 0.25s var(--ease, ease), background 0.25s var(--ease, ease);
  }
  .sv-csuggest__links a:hover {
    border-color: var(--sage);
    color: var(--ink);
    background: #fff;
  }
  .sv-ctrust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin: 0 0 clamp(24px, 3.4vw, 42px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--sans);
    font-size: 13.5px;
  }
  .sv-ctrust span {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sv-ctrust a {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s var(--ease, ease);
  }
  .sv-ctrust a:hover {
    color: var(--ink);
  }
  .sv-cgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 40px) clamp(16px, 2vw, 28px);
  }
  .sv-coll__empty {
    font-family: var(--sans);
    color: var(--ink-2);
    padding-block: 40px;
  }
  .sv-coll__empty a {
    color: var(--sage);
    text-decoration: underline;
  }

  /* Banda editorial intercalada */
  .sv-cband {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    min-height: 300px;
    display: flex;
    align-items: center;
    background: linear-gradient(150deg, #5a5f4e, #2c2f26);
    padding: clamp(28px, 5vw, 64px);
    color: #fff;
  }
  .sv-cband__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .sv-cband__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sv-cband::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(20, 22, 16, 0.66), rgba(20, 22, 16, 0.15));
  }
  .sv-cband__in {
    position: relative;
    z-index: 2;
    max-width: 42ch;
  }
  .sv-cband__title {
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 500;
    line-height: 1.05;
    margin: 12px 0 18px;
  }
  .sv-cband__text {
    font-family: var(--sans);
    line-height: 1.6;
    opacity: 0.9;
    margin: 0 0 24px;
  }

  /* Paginación numerada — un solo flex-wrap (prev · números · next) */
  .sv-pag {
    margin-top: clamp(36px, 5vw, 64px);
  }
  .sv-pag__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sv-pag__item {
    display: flex;
  }
  .sv-pag__n,
  .sv-pag__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 46px;
    height: 46px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .sv-pag__arrow {
    font-size: 20px;
  }
  a.sv-pag__n:hover,
  a.sv-pag__arrow:hover {
    border-color: var(--ink);
  }
  .sv-pag__n:focus-visible,
  .sv-pag__arrow:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .sv-pag__n.is-current {
    background-color: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }
  .sv-pag__arrow.is-off {
    opacity: 0.3;
    pointer-events: none;
  }
  .sv-pag__gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 46px;
    color: var(--ink);
    font-family: var(--sans);
    opacity: 0.5;
  }
  .sv-pag__count {
    margin: 14px 0 0;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    opacity: 0.6;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .sv-cgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 749px) {
    .sv-filterbar__in {
      gap: 12px;
    }
    .sv-csuggest {
      align-items: flex-start;
      flex-direction: column;
    }
    .sv-csuggest__links {
      width: 100%;
    }
    .sv-csuggest__links a {
      max-width: 100%;
    }
    .sv-ctrust {
      align-items: flex-start;
      flex-direction: column;
    }
    .sv-facets {
      width: 100%;
      position: relative; /* ancla el panel a la fila completa, no al chip */
    }
    /* El panel de filtro deja de anclarse a un chip suelto (que desbordaba por
       la derecha con min-width:240px) y pasa a ocupar el ancho de la fila. */
    .sv-facet { position: static; }
    .sv-facet__panel {
      left: 0;
      right: 0;
      min-width: 0;
      max-width: none;
      width: auto;
    }
    /* Paginación en móvil: se mantiene el área táctil (≥44px, WCAG 2.5.5)
       y se aprieta el espaciado para que la serie quepa sin desbordar. */
    .sv-pag__list {
      gap: 6px;
    }
    .sv-pag__n,
    .sv-pag__arrow {
      min-width: 44px;
      height: 44px;
      padding: 0 8px;
      font-size: 14px;
    }
    .sv-pag__gap {
      min-width: 20px;
      height: 44px;
    }
  }

  /* Móviles estrechos (iPhone SE y similares): la serie envuelve en dos filas
     antes que desbordar horizontalmente. */
  @media screen and (max-width: 380px) {
    .sv-pag__list {
      gap: 5px;
    }
    .sv-pag__n,
    .sv-pag__arrow {
      min-width: 42px;
      padding: 0 6px;
    }
  }
{% endstylesheet %}

