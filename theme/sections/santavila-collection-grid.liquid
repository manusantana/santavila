    { "type": "range", "id": "band_after", "label": "Insertar tras N productos", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "image_picker", "id": "band_image", "label": "Imagen de la banda" },
    { "type": "text", "id": "band_eyebrow", "label": "Eyebrow", "default": "¿No sabes por dónde empezar?" },
    { "type": "text", "id": "band_heading", "label": "Titular", "default": "Te ayudamos a elegir" },
    { "type": "textarea", "id": "band_text", "label": "Texto", "default": "Cuéntanos tu espacio y te proponemos la combinación que encaja: medidas, materiales y plazo. Atención personalizada, sin compromiso." },
    { "type": "text", "id": "band_cta_label", "label": "CTA · texto", "default": "Escríbenos" },
    { "type": "url", "id": "band_cta_link", "label": "CTA · enlace" }
  ],
  "presets": [
    { "name": "Santavila Coll. Grid" }
  ]
}
{% endschema %}
