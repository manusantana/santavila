{%- comment -%}
  Santavila · "Completa el conjunto" / upsell del carrito.
  Server-side y robusto: muestra productos de la MISMA colección que el primer
  producto del carrito (excluyéndolo). No depende de JS ni de la Recommendations API
  (que para sets/bundles puede venir vacía). Si quieres recomendaciones dinámicas
  reales, configura complementarios en Search & Discovery (ver JOURNAL).
{%- endcomment -%}
{%- liquid
  assign up_product = cart.items.first.product
  assign up_coll = blank
  for c in up_product.collections
    if c.handle != 'frontpage' and c.all_products_count > 1
      assign up_coll = c
      break
    endif
  endfor
-%}

{%- if up_product != blank and up_coll != blank -%}
  <div class="sv-section sv-upsell color-{{ section.settings.color_scheme }}">
    <div class="sv-container">
      {%- if section.settings.eyebrow != blank -%}<p class="sv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sv-upsell__title">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="sv-upsell__grid">
        {%- assign shown = 0 -%}
        {%- assign max = section.settings.max_products | default: 4 -%}
        {%- for product in up_coll.products -%}
          {%- if product.id != up_product.id and shown < max -%}
            {%- render 'santavila-product-card', product: product, sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw' -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .sv-upsell { background-color: var(--color-background); color: var(--color-foreground); }
  .sv-upsell__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.04;
    color: var(--ink);
    margin: 10px 0 clamp(24px, 3vw, 36px);
    text-wrap: balance;
  }
  .sv-upsell__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }
  @media screen and (max-width: 989px) {
    .sv-upsell__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .sv-upsell__grid { grid-template-columns: repeat(2, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Cart Upsell",
  "tag": "section",
  "class": "sv-upsell-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "También te puede gustar" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Más para tu exterior" },
    { "type": "range", "id": "max_products", "label": "Nº de productos", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Santavila Cart Upsell" } ]
}
{% endschema %}
