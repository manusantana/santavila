{%- comment -%}
  Santavila · "Completa el conjunto" (cart upsell).
  Reutiliza el componente product-recommendations de Dwell (fetch + morphSection)
  pero con la tarjeta santavila-product-card y basado en el producto del carrito.
  Intent: complementary (configurar complementarios en Search & Discovery para fidelidad).
{%- endcomment -%}
<script src="{{ 'product-recommendations.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}

{%- assign up_product = cart.items.first.product -%}
{%- if up_product != blank or recommendations.performed -%}
  <product-recommendations
    id="sv-cart-upsell-{{ section.id }}"
    class="sv-upsell-wrap"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products | default: 4 }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ up_product.id }}"
    data-intent="{{ section.settings.intent | default: 'related' }}"
    data-recommendations-performed="{{ recommendations.performed }}"
    {{ section.shopify_attributes }}
  >
    {%- if recommendations.performed and recommendations.products.size > 0 -%}
      <div class="sv-section sv-upsell color-{{ section.settings.color_scheme }}">
        <div class="sv-container">
          {%- if section.settings.eyebrow != blank -%}<p class="sv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="sv-upsell__title">{{ section.settings.heading }}</h2>{%- endif -%}
          <div class="sv-upsell__grid">
            {%- for product in recommendations.products -%}
              {%- render 'santavila-product-card', product: product, sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw' -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </product-recommendations>
{%- endif -%}

{% stylesheet %}
  .sv-upsell { background-color: var(--color-background); color: var(--color-foreground); }
  .sv-upsell__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.04;
    color: var(--ink);
    margin: 10px 0 clamp(24px, 3vw, 36px);
    text-wrap: balance;
  }
  .sv-upsell__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }
  @media screen and (max-width: 989px) {
    .sv-upsell__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .sv-upsell__grid { grid-template-columns: repeat(2, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Cart Upsell",
  "tag": "section",
  "class": "sv-upsell-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "select", "id": "intent", "label": "Tipo de recomendación", "info": "Para 'Completa el conjunto' real (complementos), configura Productos complementarios en la app Search & Discovery y elige Complementarios.", "options": [ { "value": "related", "label": "Relacionados (similares)" }, { "value": "complementary", "label": "Complementarios (completa el conjunto)" } ], "default": "related" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "También te puede gustar" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Más para tu exterior" },
    { "type": "range", "id": "max_products", "label": "Nº de productos", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Santavila Cart Upsell" } ]
}
{% endschema %}
