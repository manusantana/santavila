{%- liquid
  assign s = section.settings
  assign blocks = section.blocks
-%}

<div class="sv-section sv-editorial-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-mag__head">
      {%- if s.heading != blank -%}<h2 class="sv-mag__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: '#' }}" class="sv-ulink">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if blocks.size > 0 -%}
      <div class="sv-mag__grid">
        {%- for block in blocks -%}
          {%- if forloop.first -%}
            <a class="sv-mag-card sv-mag-card--lead" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
              <div class="sv-mag-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 980px) 100vw, 50vw', widths: '500,800,1100,1200', alt: block.settings.title }}
                {%- endif -%}
              </div>
              {%- if block.settings.category != blank -%}<div class="sv-mag-card__cat">{{ block.settings.category }}</div>{%- endif -%}
              <div class="sv-mag-card__title">{{ block.settings.title }}</div>
              {%- if block.settings.excerpt != blank -%}<p class="sv-mag-card__ex">{{ block.settings.excerpt }}</p>{%- endif -%}
            </a>
            {%- if blocks.size > 1 -%}<div class="sv-mag__col">{%- endif -%}
          {%- else -%}
            <a class="sv-mag-card" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
              <div class="sv-mag-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 980px) 50vw, 25vw', widths: '300,450,600,800', alt: block.settings.title }}
                {%- endif -%}
              </div>
              {%- if block.settings.category != blank -%}<div class="sv-mag-card__cat">{{ block.settings.category }}</div>{%- endif -%}
              <div class="sv-mag-card__title">{{ block.settings.title }}</div>
            </a>
            {%- if forloop.last -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sv-mag__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 46px;
  }
  .sv-mag__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    max-width: 14ch;
    margin: 0;
  }
  .sv-mag__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(16px, 2.4vw, 30px);
    align-items: stretch;
  }
  .sv-mag__col {
    display: grid;
    gap: clamp(16px, 2vw, 30px);
  }
  .sv-mag-card {
    display: block;
    color: inherit;
  }
  .sv-mag-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bone);
    border-radius: var(--radius-media);
    margin-bottom: 18px;
  }
  .sv-mag-card--lead .sv-mag-card__media {
    aspect-ratio: auto;
    height: 100%;
    min-height: 420px;
  }
  .sv-mag-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s var(--ease, ease);
  }
  .sv-mag-card:hover .sv-mag-card__media img {
    transform: scale(1.04);
  }
  .sv-mag-card__cat {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .sv-mag-card__title {
    font-family: var(--serif);
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 500;
    line-height: 1.1;
    margin: 8px 0 6px;
  }
  .sv-mag-card--lead .sv-mag-card__title {
    font-size: clamp(28px, 3vw, 40px);
  }
  .sv-mag-card__ex {
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 42ch;
    margin: 0;
  }
  @media screen and (max-width: 980px) {
    .sv-mag__grid {
      grid-template-columns: 1fr 1fr;
    }
    .sv-mag-card--lead {
      grid-column: 1 / -1;
    }
    .sv-mag__col {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
    }
    .sv-mag-card--lead .sv-mag-card__media {
      min-height: 320px;
    }
  }
  @media screen and (max-width: 620px) {
    .sv-mag__grid,
    .sv-mag__col {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-mag-card__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Editorial",
  "tag": "section",
  "class": "sv-editorial-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "El exterior bien vivido" },
    { "type": "text", "id": "link_label", "label": "Enlace · texto", "default": "Toda la inspiración" },
    { "type": "url", "id": "link_url", "label": "Enlace · destino" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Artículo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "category", "label": "Categoría", "default": "Guía · Materiales" },
        { "type": "text", "id": "title", "label": "Título", "default": "Cómo elegir sofá de exterior según el material" },
        { "type": "textarea", "id": "excerpt", "label": "Extracto (solo card grande)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Santavila Editorial",
      "blocks": [
        { "type": "article", "settings": { "category": "Guía · Materiales", "title": "Cómo elegir sofá de exterior según el material", "excerpt": "Cuerda, aluminio o teca: qué aguanta mejor el sol, la lluvia y el salitre, y cómo acertar a la primera para una compra que dura años." } },
        { "type": "article", "settings": { "category": "Proyecto", "title": "Amueblar un ático de 20 m²" } },
        { "type": "article", "settings": { "category": "Mantenimiento", "title": "Cuidar cojines y tejidos de exterior" } }
      ]
    }
  ]
}
{% endschema %}
