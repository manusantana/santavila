{%- liquid
  assign s = section.settings
-%}

<div class="sv-section sv-news-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    {%- if s.heading != blank -%}<h2 class="sv-news__title">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.body != blank -%}<p class="sv-news__body">{{ s.body }}</p>{%- endif -%}

    {%- form 'customer', class: 'sv-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ s.placeholder | default: 'Tu email' }}"
        aria-label="{{ s.placeholder | default: 'Tu email' }}"
        autocorrect="off"
        autocapitalize="off"
        required
      >
      <button type="submit" class="sv-btn sv-btn--light">{{ s.button_label | default: 'Suscribirme' }}</button>
    {%- endform -%}

    {%- if form.posted_successfully? -%}
      <p class="sv-news__note sv-news__note--ok">{{ s.success_text | default: '¡Gracias! Te has suscrito.' }}</p>
    {%- elsif form.errors -%}
      <p class="sv-news__note sv-news__note--err">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sv-news-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    text-align: center;
  }
  .sv-news__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.04;
    color: #fff;
    max-width: 16ch;
    margin: 0 auto 16px;
  }
  .sv-news__body {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--sage-soft);
    max-width: 44ch;
    margin: 0 auto 32px;
  }
  .sv-news__form {
    display: flex;
    gap: 10px;
    max-width: 440px;
    margin: 0 auto;
  }
  .sv-news__form input[type="email"] {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line-light);
    color: #fff;
    border-radius: 99px;
    padding: 15px 22px;
    font-family: var(--sans);
    font-size: 15px;
  }
  .sv-news__form input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .sv-news__form input[type="email"]:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .sv-news__note {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    margin: 16px 0 0;
  }
  .sv-news__note--ok {
    color: #fff;
  }
  .sv-news__note--err {
    color: var(--sand);
  }
  @media screen and (max-width: 520px) {
    .sv-news__form {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Newsletter",
  "tag": "section",
  "class": "sv-news-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-5" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Recibe ideas, no spam" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Una vez al mes: guías de exterior, nuevas colecciones y proyectos reales. Nada de descuentos permanentes." },
    { "type": "text", "id": "placeholder", "label": "Placeholder del email", "default": "Tu email" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Suscribirme" },
    { "type": "text", "id": "success_text", "label": "Mensaje de éxito", "default": "¡Gracias! Te has suscrito." }
  ],
  "presets": [
    { "name": "Santavila Newsletter" }
  ]
}
{% endschema %}
