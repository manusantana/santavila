{%- liquid
  assign s = section.settings
  assign seal_id = 'sealpath-' | append: section.id
  # Velo configurable (color + opacidad uniforme + refuerzo inferior para el texto)
  assign ov_color = s.overlay_color | default: '#141610'
  assign ov_base_alpha = s.overlay_opacity | default: 40 | divided_by: 100.0
  assign ov_grad_alpha = s.overlay_gradient | default: 60 | divided_by: 100.0
  assign ov_base = ov_color | color_modify: 'alpha', ov_base_alpha
  assign ov_grad = ov_color | color_modify: 'alpha', ov_grad_alpha
  # Color del texto y caja/fondo opcional tras el texto
  assign txt_color = s.text_color | default: '#FFFFFF'
  assign panel_alpha = s.panel_opacity | default: 30 | divided_by: 100.0
  assign panel_bg = s.panel_color | default: '#141610' | color_modify: 'alpha', panel_alpha
  # Altura fija opcional
  assign h_desktop = s.height_desktop | default: 720
  assign h_mobile = s.height_mobile | default: 480
-%}

<div class="sv-hero" style="--sv-hero-h: {% if s.height_mode == 'fixed' %}{{ h_desktop }}px{% elsif s.hero_size == 'secondary' %}var(--hero-h-secondary){% else %}var(--hero-h){% endif %};{% if s.height_mode == 'fixed' %} --sv-hero-h-mobile: {{ h_mobile }}px;{% endif %} --sv-text-color: {{ txt_color }}; --sv-ov-base: {{ ov_base }}; --sv-ov-grad: {{ ov_grad }};">
  {%- if s.image != blank -%}
    <div class="sv-hero__media">
      {{
        s.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          alt: s.image.alt | default: shop.name
      }}
    </div>
  {%- endif -%}

  <div class="sv-hero__inner">
    <div class="sv-hero__box{% if s.text_panel %} is-panel{% endif %}"{% if s.text_panel %} style="--sv-panel-bg: {{ panel_bg }}; --sv-panel-radius: {{ s.panel_radius | default: 10 }}px; --sv-panel-bw: {{ s.panel_border | default: 0 }}px; --sv-panel-bc: {{ s.panel_border_color | default: '#FFFFFF' }};"{% endif %}>
    {%- if s.eyebrow != blank -%}
      <p class="sv-hero__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading_line1 != blank or s.heading_line2 != blank -%}
      <h1 class="sv-hero__title">
        {{- s.heading_line1 -}}
        {%- if s.heading_line2 != blank -%}
          <br><em>{{ s.heading_line2 }}</em>
        {%- endif -%}
      </h1>
    {%- endif -%}

    <div class="sv-hero__row">
      {%- if s.subheading != blank -%}
        <p class="sv-hero__sub">{{ s.subheading }}</p>
      {%- endif -%}

      <div class="sv-hero__right">
        {%- if s.show_seal -%}
          <div class="sv-hero__seal" aria-hidden="true">
            <svg class="sv-hero__seal-ring" viewBox="0 0 160 160">
              <defs>
                <path id="{{ seal_id }}" d="M80,80 m-60,0 a60,60 0 1,1 120,0 a60,60 0 1,1 -120,0"></path>
              </defs>
              <text><textPath href="#{{ seal_id }}" startOffset="0">{{ s.seal_text }}</textPath></text>
            </svg>
            <span class="sv-hero__seal-mark">
              <svg width="34" height="55" viewBox="0 0 100 162" fill="none" aria-hidden="true">
                <path d="M30 12 C58 12 80 32 80 64 L82 150 L58 150 L56 64 C56 40 42 22 22 16 C25 13 27 12 30 12 Z" fill="rgba(255,255,255,0.25)" stroke="#F7F4EC" stroke-width="5" stroke-linejoin="round"></path>
                <path d="M14 60 C14 30 30 14 44 14 C58 14 74 30 74 60 L76 150 L12 150 Z" fill="none" stroke="#F7F4EC" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"></path>
              </svg>
            </span>
          </div>
        {%- endif -%}

        {%- if s.cta1_label != blank or s.cta2_label != blank -%}
          <div class="sv-hero__cta">
            {%- if s.cta1_label != blank -%}
              <a href="{{ s.cta1_link | default: '#' }}" class="sv-btn sv-btn--light">
                {{ s.cta1_label }}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
            {%- if s.cta2_label != blank -%}
              <a href="{{ s.cta2_link | default: '#' }}" class="sv-btn sv-btn--ghost">{{ s.cta2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>

  {%- if s.show_scroll -%}
    <div class="sv-hero__scroll" aria-hidden="true"><span>{{ s.scroll_label }}</span><i></i></div>
  {%- endif -%}
</div>

{% stylesheet %}
  .sv-hero {
    position: relative;
    min-height: var(--sv-hero-h, var(--hero-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--sv-text-color, #fff);
    background: linear-gradient(150deg, #4f5447 0%, #2c2f26 55%, #3a3f31 100%);
  }

  .sv-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .sv-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Velo configurable: capa uniforme (--sv-ov-base) + refuerzo arriba (header)
     y abajo (texto) (--sv-ov-grad). Ambos derivan del color/opacidad del schema. */
  .sv-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        var(--sv-ov-grad, rgba(20, 22, 16, 0.6)) 0%,
        transparent 24%,
        transparent 58%,
        var(--sv-ov-grad, rgba(20, 22, 16, 0.6)) 100%
      ),
      var(--sv-ov-base, rgba(20, 22, 16, 0.4));
  }

  .sv-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--maxw, 1480px);
    margin-inline: auto;
    padding-inline: var(--gut, clamp(20px, 5vw, 76px));
    padding-bottom: clamp(48px, 8vh, 104px);
    padding-top: clamp(120px, 18vh, 200px);
  }

  /* Caja/fondo opcional tras el texto (alternativa al velo global) */
  .sv-hero__box.is-panel {
    background: var(--sv-panel-bg, rgba(20, 22, 16, 0.3));
    border-radius: var(--sv-panel-radius, 10px);
    border: var(--sv-panel-bw, 0px) solid var(--sv-panel-bc, #fff);
    padding: clamp(26px, 3.5vw, 52px);
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
  }

  .sv-hero__eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--sv-text-color, #fff);
    opacity: 0.92;
    margin: 0 0 26px;
  }

  .sv-hero__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(54px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    max-width: 14ch;
    margin: 0;
  }
  .sv-hero__title em {
    font-style: italic;
  }

  .sv-hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: 38px;
    flex-wrap: wrap;
  }
  .sv-hero__sub {
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.5;
    max-width: 40ch;
    opacity: 0.94;
    margin: 0;
  }
  .sv-hero__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 26px;
  }

  /* Sello rotatorio */
  .sv-hero__seal {
    position: relative;
    width: 150px;
    height: 150px;
    flex: none;
  }
  .sv-hero__seal-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: sv-sealspin 30s linear infinite;
  }
  .sv-hero__seal-ring text {
    font-family: var(--mono);
    font-size: 9.2px;
    letter-spacing: 0.16em;
    fill: #fff;
    text-transform: uppercase;
  }
  .sv-hero__seal-mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  @keyframes sv-sealspin {
    to {
      transform: rotate(360deg);
    }
  }

  /* CTAs (pill) */
  .sv-hero__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  /* .sv-btn (light / ghost) viven en santavila-components.css */

  /* Indicador "Descubre" */
  .sv-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    display: grid;
    place-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .sv-hero__scroll i {
    width: 1px;
    height: 42px;
    background: linear-gradient(#fff, transparent);
    animation: sv-scrolldrop 2.4s var(--ease-soft, ease) infinite;
  }
  @keyframes sv-scrolldrop {
    0% { transform: scaleY(0); transform-origin: top; }
    45% { transform: scaleY(1); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media screen and (max-width: 749px) {
    .sv-hero { min-height: var(--sv-hero-h-mobile, var(--sv-hero-h)); }
    /* el bloque cabía justo en 100svh: bajamos paddings y el mínimo del título */
    .sv-hero__inner {
      padding-top: clamp(92px, 13vh, 140px);
      padding-bottom: clamp(36px, 6vh, 80px);
    }
    .sv-hero__title { font-size: clamp(40px, 11vw, 76px); }
    .sv-hero__right {
      align-items: flex-start;
      gap: 20px;
    }
    .sv-hero__seal {
      width: 118px;
      height: 118px;
    }
    /* la flecha "Descubre" (absolute bottom) se solapaba con los CTAs en móvil */
    .sv-hero__scroll { display: none; }
  }

  /* Regla de oro: el contenido nunca depende de animación para verse.
     Solo desactivamos los movimientos como mejora progresiva. */
  @media (prefers-reduced-motion: reduce) {
    .sv-hero__seal-ring,
    .sv-hero__scroll i {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Hero",
  "tag": "section",
  "class": "sv-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo",
      "info": "Opcional. Sin imagen se usa el degradado sage de marca."
    },
    {
      "type": "select",
      "id": "hero_size",
      "label": "Altura",
      "options": [
        { "value": "full", "label": "Pantalla completa" },
        { "value": "secondary", "label": "Casi completa (deja asomar)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Tipo de altura",
      "options": [
        { "value": "theme", "label": "Automática (del tema)" },
        { "value": "fixed", "label": "Fija (px)" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Altura fija · escritorio",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720,
      "info": "Solo si 'Tipo de altura' = Fija."
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura fija · móvil",
      "min": 240,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 480,
      "info": "Solo si 'Tipo de altura' = Fija."
    },
    {
      "type": "header",
      "content": "Velo / legibilidad sobre la imagen"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color del velo",
      "default": "#141610"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del velo",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "Velo uniforme sobre toda la imagen. Súbelo si el texto no se lee bien."
    },
    {
      "type": "range",
      "id": "overlay_gradient",
      "label": "Refuerzo arriba y abajo",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60,
      "info": "Oscurece más la franja del menú (arriba) y la del título y botones (abajo)."
    },
    {
      "type": "header",
      "content": "Texto y caja"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "text_panel",
      "label": "Fondo (caja) tras el texto",
      "default": false,
      "info": "Panel semitransparente detrás del texto, como alternativa al velo global. Si lo activas, baja el velo."
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Caja · color",
      "default": "#141610"
    },
    {
      "type": "range",
      "id": "panel_opacity",
      "label": "Caja · opacidad",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Caja · esquinas",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "panel_border",
      "label": "Caja · grosor del borde",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "Caja · color del borde",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Diseño español para vivir fuera"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Titular · línea 1",
      "default": "El exterior,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Titular · línea 2 (itálica)",
      "default": "bien vivido."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Mobiliario de exterior fabricado en España. Diseño mediterráneo contemporáneo, preparado para durar y pensado para tu casa real."
    },
    {
      "type": "header",
      "content": "Llamadas a la acción"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "CTA principal · texto",
      "default": "Explorar colecciones"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "CTA principal · enlace"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "CTA secundaria · texto",
      "default": "Amueblar por espacio"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "CTA secundaria · enlace"
    },
    {
      "type": "header",
      "content": "Sello rotatorio"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Mostrar sello",
      "default": true
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Texto del sello (orbita)",
      "default": "FABRICADO EN ESPAÑA · DISEÑO PARA VIVIR FUERA · "
    },
    {
      "type": "header",
      "content": "Indicador de scroll"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Mostrar indicador",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Texto del indicador",
      "default": "Descubre"
    }
  ],
  "presets": [
    {
      "name": "Santavila Hero"
    }
  ]
}
{% endschema %}
