{%- liquid
  assign s = section.settings
  if s.media_position == 'right'
    assign rev = ' sv-feat--rev'
  else
    assign rev = ''
  endif
-%}

<div class="sv-section sv-pro-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-feat{{ rev }}">
      <div class="sv-feat__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 100vw, 55vw', widths: '500,800,1100,1400', alt: s.image.alt | default: s.heading }}
        {%- endif -%}
      </div>
      <div class="sv-feat__content">
        {%- if s.eyebrow != blank -%}<p class="sv-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sv-feat__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<p class="sv-feat__body">{{ s.body }}</p>{%- endif -%}
        {%- if s.cta_label != blank -%}
          <div class="sv-feat__cta">
            <a href="{{ s.cta_link | default: '#' }}" class="sv-btn sv-btn--sage">
              {{ s.cta_label }}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Santavila Profesionales",
  "tag": "section",
  "class": "sv-pro-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Santavila Profesionales" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Exterior de proyecto" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Para interioristas, hostelería y pequeños negocios con gusto. Prescripción, packs por proyecto, presupuesto rápido, documentación técnica y un canal humano directo. Condiciones específicas y disponibilidad para volumen." },
    { "type": "text", "id": "cta_label", "label": "CTA · texto", "default": "Pedir propuesta" },
    { "type": "url", "id": "cta_link", "label": "CTA · enlace" }
  ],
  "presets": [
    { "name": "Santavila Profesionales" }
  ]
}
{% endschema %}
