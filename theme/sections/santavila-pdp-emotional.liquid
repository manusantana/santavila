{%- liquid
  assign s = section.settings
-%}
<div class="sv-section sv-emo-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-emo__inner">
      {%- if s.eyebrow != blank -%}<p class="sv-eyebrow" style="color:var(--sage-soft)">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.statement != blank -%}<p class="sv-emo__text">{{ s.statement }}</p>{%- endif -%}
      {%- if s.support != blank -%}<p class="sv-emo__support">{{ s.support }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sv-emo-section { background-color: var(--color-background); color: var(--color-foreground); }
  .sv-emo__inner { max-width: 32ch; }
  .sv-emo__text { font-family: var(--serif); font-weight: 500; font-size: clamp(30px,4.4vw,60px); line-height: 1.08; color: #fff; margin: 16px 0 0; text-wrap: balance; letter-spacing: -0.01em; }
  .sv-emo__support { font-family: var(--sans); font-size: clamp(16px,1.4vw,19px); line-height: 1.6; color: var(--sage-soft); margin: 24px 0 0; max-width: 46ch; }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila PDP Emocional",
  "tag": "section",
  "class": "sv-emo-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-5" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "El exterior bien vivido" },
    { "type": "textarea", "id": "statement", "label": "Statement", "default": "El sitio donde la casa respira y los domingos duran más." },
    { "type": "textarea", "id": "support", "label": "Texto de apoyo", "default": "Diseño español pensado para vivir fuera todo el año: materiales que aguantan sol, lluvia y salitre, y un asiento en el que de verdad apetece quedarse." }
  ],
  "presets": [ { "name": "Santavila PDP Emocional" } ]
}
{% endschema %}
