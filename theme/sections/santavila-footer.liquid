{%- liquid
  assign s = section.settings
-%}

<div class="sv-ft color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-ft__top">
      <div class="sv-ft__brand">
        {%- if settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="sv-ft__logo" aria-label="{{ shop.name }}">
            {{ settings.logo | image_url: width: 260 | image_tag: widths: '130, 260', alt: shop.name, loading: 'lazy' }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="sv-ft__logo sv-ft__logo--text">{{ shop.name }}</a>
        {%- endif -%}
        {%- if s.tagline != blank -%}<p class="sv-ft__tagline">{{ s.tagline }}</p>{%- endif -%}
        <div class="sv-ft__social">
          {%- if s.instagram_url != blank -%}
            <a href="{{ s.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if s.pinterest_url != blank -%}
            <a href="{{ s.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-.5-2 0-4 1-6.5M12 3a7 7 0 00-3 13.4M12 3a6 6 0 011 11.9"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="sv-ft__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h5>{{ block.settings.heading }}</h5>{%- endif -%}
          {%- if block.settings.menu != blank -%}
            {%- for link in linklists[block.settings.menu].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="sv-ft__bottom">
      <span>{{ s.copyright | default: '© Santavila' }}</span>
      <nav class="sv-ft__legal" aria-label="Información legal">
        <a href="{{ routes.root_url }}policies/legal-notice">Aviso legal</a>
        <a href="{{ routes.root_url }}policies/privacy-policy">Política de privacidad</a>
        <a href="{{ routes.root_url }}policies/terms-of-service">Condiciones de venta</a>
        <a href="{{ routes.root_url }}policies/refund-policy">Devoluciones</a>
        <a href="{{ routes.root_url }}policies/shipping-policy">Envío</a>
      </nav>
      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <div class="sv-ft__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'sv-ft__payicon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sv-ft {
    background-color: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid var(--line);
  }
  .sv-ft__top {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    gap: 40px;
    padding-block: clamp(48px, 7vw, 88px);
  }
  .sv-ft__logo img {
    height: 26px;
    width: auto;
    display: block;
    margin-bottom: 20px;
  }
  .sv-ft__logo--text {
    font-family: var(--serif);
    font-size: 24px;
    display: inline-block;
    margin-bottom: 20px;
  }
  .sv-ft__tagline {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0 0 24px;
  }
  .sv-ft__social {
    display: flex;
    gap: 12px;
  }
  .sv-ft__social a {
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 99px;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    transition: all 0.3s var(--ease, ease);
  }
  .sv-ft__social a:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .sv-ft__col h5 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 18px;
  }
  .sv-ft__col a {
    display: block;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink-2);
    margin-bottom: 12px;
    transition: color 0.25s var(--ease, ease);
  }
  .sv-ft__col a:hover {
    color: var(--ink);
  }
  .sv-ft__bottom {
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-block: 24px;
    flex-wrap: wrap;
  }
  .sv-ft__bottom span {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .sv-ft__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: center;
  }
  .sv-ft__legal a {
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--ink-3);
    transition: color 0.2s var(--ease, ease);
  }
  .sv-ft__legal a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .sv-ft__pay {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .sv-ft__pay .sv-ft__payicon {
    width: 36px;
    height: 23px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-2);
  }
  @media screen and (max-width: 860px) {
    .sv-ft__top {
      grid-template-columns: 1fr 1fr;
    }
    .sv-ft__brand {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Footer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "paragraph", "content": "El logo se toma del logo general del tema (Configuración del tema)." },
    { "type": "textarea", "id": "tagline", "label": "Eslogan", "default": "Diseño español para vivir fuera. Mobiliario de exterior fabricado en España, con diseño mediterráneo contemporáneo." },
    { "type": "header", "content": "Redes" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "header", "content": "Inferior" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 Santavila · Fabricado en España" },
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar iconos de pago", "default": true }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Santavila Footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Tienda" } },
        { "type": "column", "settings": { "heading": "Ayuda" } },
        { "type": "column", "settings": { "heading": "Santavila" } }
      ]
    }
  ]
}
{% endschema %}
