{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign limit = s.max_products | default: 4
-%}

<div class="sv-section sv-product-row-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-prow__head">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="sv-eyebrow" style="margin-bottom:14px">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sv-prow__title">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: col.url | default: '#' }}" class="sv-ulink">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="sv-pgrid" style="--sv-cols: {{ s.columns | default: 4 }};">
      {%- if col.products.size > 0 -%}
        {%- for product in col.products limit: limit -%}
          {%- liquid
            assign lt = product.metafields.santavila.lead_time_type
            assign ltlabel = product.metafields.santavila.lead_time_label
            assign badge = product.metafields.santavila.badge
            assign ship = ''
            assign ship_clay = false
            if lt == 'made_to_order'
              assign ship = 'Bajo pedido'
              assign ship_clay = true
            elsif lt == 'quick_ship'
              assign ship = ltlabel | default: 'Quick ship'
            elsif ltlabel != blank
              assign ship = ltlabel
            endif
          -%}
          <a class="sv-pcard" href="{{ product.url }}">
            <div class="sv-pcard__media">
              {%- if badge != blank -%}<span class="sv-pcard__badge">{{ badge }}</span>{%- endif -%}
              {%- if s.show_wishlist -%}
                <span class="sv-pcard__fav" aria-hidden="true">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-9.5A3.5 3.5 0 0112 8a3.5 3.5 0 017 2.5C19 15.5 12 20 12 20z"/></svg>
                </span>
              {%- endif -%}
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 980px) 50vw, 25vw',
                    widths: '300, 450, 600, 800',
                    alt: product.featured_media.alt | default: product.title
                }}
              {%- endif -%}
            </div>
            {%- if product.type != blank -%}<div class="sv-pcard__cat">{{ product.type }}</div>{%- endif -%}
            <div class="sv-pcard__name">{{ product.title }}</div>
            <div class="sv-pcard__foot">
              <span class="sv-pcard__price">
                {{- product.price | money_without_trailing_zeros -}}
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </span>
              {%- if ship != blank -%}
                <span class="sv-pcard__ship{% if ship_clay %} sv-pcard__ship--clay{% endif %}">{{ ship }}</span>
              {%- endif -%}
            </div>
            {%- capture swatches -%}
              {%- for option in product.options_with_values -%}
                {%- for value in option.values -%}
                  {%- if value.swatch.color and forloop.index <= 6 -%}
                    <i style="background: {{ value.swatch.color }}"></i>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- assign swatches_clean = swatches | strip -%}
            {%- if swatches_clean != '' -%}
              <div class="sv-pcard__swatches">{{ swatches_clean }}</div>
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        <p class="sv-prow__empty">Selecciona una colección en el editor de tema para mostrar productos aquí.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sv-prow__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .sv-prow__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .sv-pgrid {
    display: grid;
    grid-template-columns: repeat(var(--sv-cols, 4), 1fr);
    gap: clamp(14px, 2vw, 28px);
  }

  .sv-pcard {
    display: block;
    color: inherit;
  }
  .sv-pcard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bone);
    margin-bottom: 16px;
    border-radius: 4px;
  }
  .sv-pcard__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s var(--ease, ease);
  }
  .sv-pcard:hover .sv-pcard__media img {
    transform: scale(1.04);
  }
  .sv-pcard__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(247, 244, 236, 0.92);
    color: var(--sage-deep);
    padding: 5px 10px;
    border-radius: 99px;
  }
  .sv-pcard__fav {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 99px;
    background: rgba(247, 244, 236, 0.9);
    display: grid;
    place-items: center;
    color: var(--ink-2);
    opacity: 0;
    transform: translateY(-4px);
    transition: all 0.4s var(--ease, ease);
  }
  .sv-pcard:hover .sv-pcard__fav {
    opacity: 1;
    transform: none;
  }
  .sv-pcard__cat {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sv-pcard__name {
    font-family: var(--serif);
    font-size: 23px;
    font-weight: 500;
    margin: 5px 0 9px;
  }
  .sv-pcard__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .sv-pcard__price {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
  }
  .sv-pcard__price s {
    color: var(--ink-3);
    font-weight: 400;
    margin-left: 6px;
  }
  .sv-pcard__ship {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage);
    white-space: nowrap;
  }
  .sv-pcard__ship--clay {
    color: var(--clay-deep);
  }
  .sv-pcard__swatches {
    display: flex;
    gap: 5px;
    margin-top: 11px;
  }
  .sv-pcard__swatches i {
    width: 14px;
    height: 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    display: inline-block;
  }
  .sv-prow__empty {
    grid-column: 1 / -1;
    font-family: var(--sans);
    color: var(--ink-3);
  }
  @media screen and (max-width: 980px) {
    .sv-pgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-pcard__media img,
    .sv-pcard__fav {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Lo más deseado",
  "tag": "section",
  "class": "sv-product-row-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (opcional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Lo más deseado"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Nº de productos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Enlace · texto",
      "default": "Ver toda la tienda"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Enlace · destino"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Mostrar corazón de favoritos",
      "info": "Requiere app de wishlist para funcionar. Off por defecto.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Santavila Lo más deseado"
    }
  ]
}
{% endschema %}
