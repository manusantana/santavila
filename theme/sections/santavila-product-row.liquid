{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign limit = s.max_products | default: 4
-%}

<div class="sv-section sv-product-row-section color-{{ s.color_scheme }}">
  <div class="sv-container">
    <div class="sv-prow__head">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="sv-eyebrow" style="margin-bottom:14px">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sv-prow__title">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ s.link_url | default: col.url | default: '#' }}" class="sv-ulink">{{ s.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="sv-pgrid" style="--sv-cols: {{ s.columns | default: 4 }};">
      {%- if col.products.size > 0 -%}
        {%- for product in col.products limit: limit -%}
          {%- render 'santavila-product-card', product: product, show_wishlist: s.show_wishlist -%}
        {%- endfor -%}
      {%- else -%}
        <p class="sv-prow__empty">Selecciona una colección en el editor de tema para mostrar productos aquí.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sv-prow__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .sv-prow__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sv-pgrid {
    display: grid;
    grid-template-columns: repeat(var(--sv-cols, 4), 1fr);
    gap: clamp(14px, 2vw, 28px);
  }
  .sv-prow__empty {
    grid-column: 1 / -1;
    font-family: var(--sans);
    color: var(--ink-3);
  }
  @media screen and (max-width: 980px) {
    .sv-pgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Santavila Lo más deseado",
  "tag": "section",
  "class": "sv-product-row-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (opcional)" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo más deseado" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "max_products", "label": "Nº de productos", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columnas (escritorio)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Enlace · texto", "default": "Ver toda la tienda" },
    { "type": "url", "id": "link_url", "label": "Enlace · destino" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Mostrar corazón de favoritos", "info": "Requiere app de wishlist para funcionar. Off por defecto.", "default": false }
  ],
  "presets": [
    { "name": "Santavila Lo más deseado" }
  ]
}
{% endschema %}
